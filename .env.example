# MongoDB instance (admin connection string)
MONGODB_CONNECTION_STRING=mongodb://localhost:27017?authSource=admin

# Session cookie signing
SESSION_COOKIE_NAME=self-service-nosql-session
SESSION_SECRET=

# MongoDB host shown to users in the UI
NEXT_PUBLIC_MONGODB_HOST=

# Optional UI links / hints
NEXT_PUBLIC_HELP_URL=
NEXT_PUBLIC_LOGIN_HINT=
